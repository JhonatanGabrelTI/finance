# Configure these values in Vercel > Project > Settings > Environment Variables.
# Use a unique, long random string for BLACKFIN_SESSION_SECRET in every environment.
BLACKFIN_SESSION_SECRET=replace-with-a-long-random-secret

# Empresarial (keeps the existing access when omitted locally)
BLACKFIN_REGISTRATION_CODE=160526
BLACKFIN_ACCESS_PASSWORD=Barbearia2026

# Pessoal (o código de acesso também deve conter somente números)
BLACKFIN_PERSONAL_REGISTRATION_CODE=260926
BLACKFIN_PERSONAL_PASSWORD=Pessoal2026
